---
import {Icon} from "astro-icon/components";
import {sectionConfig} from "../data/collections";
import type {CollectionEntry} from "../data/collections";
interface Props {items:CollectionEntry[];recent?:boolean;}
const {items,recent=false}=Astro.props;
---
<div class="song-list">{items.map(item=>{
 const href=item.url||(recent?sectionConfig[item.kind].href:undefined);
 const external=href?.startsWith('http');
 return <article class="song-row interactive-row" data-entry data-status={item.status} data-search={[item.title,item.creator,item.note,...(item.tags??[])].filter(Boolean).join(' ').toLowerCase()}>
  <span class="song-cover cover-window">{item.cover?<img src={item.cover} alt="" loading="lazy" width="80" height="80"/>:<span class="song-placeholder"><Icon name={sectionConfig[item.kind].icon}/></span>}</span>
  <div class="song-info"><h2>{href?<a class="whole-link" href={href} target={external?'_blank':undefined} rel={external?'noopener noreferrer':undefined} data-no-swup>{item.title}</a>:item.title}</h2><p>{item.creator}{recent&&<span class="entry-section">{item.creator?' · ':''}{sectionConfig[item.kind].title}{sectionConfig[item.kind].sub&&' / '+sectionConfig[item.kind].sub}</span>}</p>{!recent&&item.note&&<p class="song-note">{item.note}</p>}{!recent&&item.tags?.length&&<p class="song-tags">{item.tags.map(tag=><span>#{tag}</span>)}</p>}</div>
  <time datetime={item.date}>{item.date.replaceAll('-','.')}</time>
 </article>;
})}</div>
