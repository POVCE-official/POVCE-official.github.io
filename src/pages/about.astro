---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {Icon} from "astro-icon/components";
import {copy,settings} from "../data/collections";
import "../styles/archive.css";
---
<MainGridLayout title={copy.aboutTitle} description={copy.aboutText} page="about"><section class="archive-panel"><p class="archive-eyebrow">{settings.name}</p><h1>{copy.aboutTitle}</h1><p class="archive-prose">{copy.aboutText}</p><p class="archive-prose">{copy.aboutMore}</p><footer class="about-footer"><div class="quiet-links"><a class="quiet-link" href="/works/">{copy.works}</a><a class="quiet-link" href={settings.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></div><section class="about-contact" aria-labelledby="about-contact-title"><a class="contact-x" href="https://x.com/povcemt" target="_blank" rel="noopener noreferrer" data-no-swup aria-label="联系我 · X 个人主页" title="X · @povcemt"><Icon name="simple-icons:x"/></a><h2 id="about-contact-title">联系我</h2></section></footer></section></MainGridLayout>

<style>
.about-footer{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1.5rem;margin-top:1.5rem}.about-footer .quiet-links{margin-top:0;line-height:1.5}.about-contact{display:flex;flex-direction:column;align-items:center;gap:.6rem;margin-left:auto}.about-contact h2{font-size:.9rem;line-height:1.5;font-weight:500;color:var(--on-surface-variant);margin:0}.contact-x{display:grid;place-items:center;width:2.75rem;height:2.75rem;min-width:44px;min-height:44px;border-radius:50%;border:1px solid var(--outline-variant);background:var(--surface-container-high);color:var(--on-surface);text-decoration:none;transition:background var(--m3e-duration-short) var(--m3e-easing-standard)}.contact-x svg{width:1.1rem;height:1.1rem}.contact-x:hover{background:var(--primary-container);color:var(--on-primary-container)}.contact-x:focus-visible{outline:3px solid var(--primary);outline-offset:4px}@media(prefers-reduced-motion:reduce){.contact-x{transition:none}}
</style>
