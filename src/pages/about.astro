---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {copy,settings} from "../data/collections";
import "../styles/archive.css";
---
<MainGridLayout title={copy.aboutTitle} description={copy.aboutText} page="about"><section class="archive-panel"><p class="archive-eyebrow">{settings.name}</p><h1>{copy.aboutTitle}</h1><p class="archive-prose">{copy.aboutText}</p><p class="archive-prose">{copy.aboutMore}</p><div class="quiet-links"><a class="quiet-link" href="/works/">{copy.works}</a><a class="quiet-link" href={settings.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></div></section></MainGridLayout>
