---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {copy,works} from "../data/collections";
import "../styles/archive.css";
---
<MainGridLayout title={copy.works} description={copy.worksText} page="projects"><section class="archive-panel"><h1>{copy.works}</h1><p class="archive-prose">{copy.worksText}</p>{works.length?works.map(work=><article class="entry"><h2>{work.title}</h2><p>{work.description}</p><a class="quiet-link" href={work.url} target="_blank" rel="noopener noreferrer">{copy.link}</a></article>):<div class="empty-state"><p>{copy.worksEmpty}</p></div>}<a class="quiet-link" href="/about/">{copy.aboutTitle}</a></section></MainGridLayout>
